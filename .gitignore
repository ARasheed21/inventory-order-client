\.delegate
skills-lock.json

\.opencode
\.specify

# Monorepo / Melos
melos_overrides.yaml
pubspec_overrides.yaml

# Environment files (FR-014) - never commit real env values
.env
.env.*
!.env.example
**/config.env

# Build outputs
app/build/
web/build/
build/
coverage/
*.lcov

# Jaspr
.web/

