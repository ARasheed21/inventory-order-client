# Environment configuration template (FR-014).
# Copy to .env and adjust per environment. NEVER commit real .env files.

# REST API base URL (local backend container default)
API_BASE_URL=http://localhost:8080

# Real-time WebSocket endpoint (STOMP)
WS_URL=ws://localhost:8080/api/ws/websocket

# Sentry crash reporting DSN (required for release builds, optional in dev)
SENTRY_DSN=

# Comma-separated SHA-256 SPKI certificate pins for backend hosts
# (required in release builds; dev bypasses pinning)
CERT_PINS=

# Environment name: dev | staging
APP_ENV=dev
